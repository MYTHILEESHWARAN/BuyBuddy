# ──────────────────────────────────────────────────────────
# ShopNow E-Commerce — Backend Environment Variables
# ──────────────────────────────────────────────────────────

# 1. MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/ecommerce

# 2. JWT Secret Key
JWT_SECRET=shopnow_super_secret_jwt_key_2024_change_in_production

# 3. Server Port
PORT=5000

# 4. Real Email Configuration (Nodemailer SMTP)
# For Gmail: Use smtp.gmail.com, port 587, your full Gmail address, and a 16-character Google App Password (not your Gmail login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ShopNow <no-reply@shopnow.com>

# 5. Frontend Client URL (for CORS allowed origins)
CLIENT_URL=http://localhost:5173

# 6. Optional Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 7. Optional Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 8. Optional Shiprocket (Logistics)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# 9. Optional AI Tutor
GEMINI_API_KEY=
